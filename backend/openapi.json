            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LeagueBoxScoresResponse": {
        "properties": {
          "fetched_at": {
            "description": "When this service fetched the data from ESPN (UTC, ISO 8601).",
            "examples": ["2026-10-23T14:05:12.345678+00:00"],
            "title": "Fetched At",
            "type": "string"
          },
          "league_id": {
            "description": "ESPN league ID this service is configured for.",
            "examples": ["123456"],
            "title": "League Id",
            "type": "string"
          },
          "matchups": {
            "description": "Current-week matchups only; a side with no lineup data yet is omitted.",
            "items": {
              "$ref": "#/components/schemas/MatchupBoxScoreOut"
            },
            "title": "Matchups",
            "type": "array"
          },
          "season": {
            "description": "NFL season year the data belongs to.",
            "examples": [2026],
            "title": "Season",
            "type": "integer"
          },
          "warnings": {
            "description": "Non-fatal problems, one string per skipped item (e.g. a player with no usable name). Empty when everything parsed cleanly.",
            "examples": [[]],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": ["season", "league_id", "fetched_at", "matchups", "warnings"],
        "title": "LeagueBoxScoresResponse",
        "type": "object"
      },
