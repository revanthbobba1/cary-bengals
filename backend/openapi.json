{
  "components": {
    "schemas": {
      "BoxScorePlayerOut": {
        "properties": {
          "is_starter": {
            "description": "True unless the slot is Bench or IR.",
            "title": "Is Starter",
            "type": "boolean"
          },
          "lineup_slot": {
            "description": "Lineup slot the player occupies this week: QB, RB, WR, TE, RB/WR, WR/TE, OP, FLEX, D/ST, K, Bench or IR.",
            "examples": ["FLEX"],
            "title": "Lineup Slot",
            "type": "string"
          },
          "name": {
            "examples": ["Ja'Marr Chase"],
            "title": "Name",
            "type": "string"
          },
          "points": {
            "description": "Fantasy points scored this week.",
            "examples": [21.4],
            "title": "Points",
            "type": "number"
          },
          "position": {
            "description": "Player's natural position.",
            "examples": ["QB", "RB", "WR", "TE", "K", "D/ST"],
            "title": "Position",
            "type": "string"
          },
          "pro_team": {
            "description": "NFL team abbreviation.",
            "examples": ["CIN"],
            "title": "Pro Team",
            "type": "string"
          }
        },
        "required": ["name", "position", "pro_team", "lineup_slot", "is_starter", "points"],
        "title": "BoxScorePlayerOut",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "description": "Human-readable reason for the failure.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": ["detail"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
