        "parameters": [
          {
            "description": "NFL season year to fetch. Must be one the league has data for.",
            "in": "path",
            "name": "season",
            "required": true,
            "schema": {
              "description": "NFL season year to fetch. Must be one the league has data for.",
              "examples": [2026],
              "minimum": 2000,
              "title": "Season",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueRostersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`X-Service-Token` header missing or incorrect."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ESPN could not be read: expired cookies (private leagues), unknown league ID, request failure/timeout, or a response shape this service doesn't recognize. `detail` says which."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List team rosters",
        "tags": ["roster"]
      }
    },
