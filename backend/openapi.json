  "info": {
    "description": "Private service that reads the league's ESPN fantasy data and returns it in a stable, sanitized shape. Only the Next.js server calls it; ESPN cookies never leave it. Every `/v1` endpoint requires the `X-Service-Token` header.",
    "title": "Cary Bengals ESPN Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Returns 200 whenever the process is up. Unauthenticated; does not touch ESPN.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": ["health"]
      }
    },
    "/readyz": {
      "get": {
        "description": "Returns 200 once the service can take traffic. Unauthenticated; no ESPN call.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Readyz Readyz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness check",
        "tags": ["health"]
      }
    },
    "/v1/league/{season}/boxscores": {
      "get": {
        "description": "Per-player fantasy points for each side of each matchup that currently has lineup data (the in-progress week). Join to `/schedule` on `espn_matchup_id`.\n\n**Not cached** -- polled every ~10 minutes during live games.",
        "operationId": "get_boxscores_v1_league__season__boxscores_get",
        "parameters": [
          {
            "description": "NFL season year to fetch. Must be one the league has data for.",
            "in": "path",
            "name": "season",
            "required": true,
            "schema": {
              "description": "NFL season year to fetch. Must be one the league has data for.",
              "examples": [2026],
              "minimum": 2000,
              "title": "Season",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueBoxScoresResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`X-Service-Token` header missing or incorrect."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ESPN could not be read: expired cookies (private leagues), unknown league ID, request failure/timeout, or a response shape this service doesn't recognize. `detail` says which."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List live box scores",
        "tags": ["boxscore"]
      }
    },
