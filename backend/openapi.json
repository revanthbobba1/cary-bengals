        "description": "Every matchup for every week with scores. For the in-progress week, scores are the live running total and projected score / win probability are populated; for other weeks those are null.\n\nA matchup missing a home or away team (a bye) is skipped and reported in `warnings`.\n\n**Not cached** -- polled every ~10 minutes during live games.",
        "operationId": "get_schedule_v1_league__season__schedule_get",
        "parameters": [
          {
            "description": "NFL season year to fetch. Must be one the league has data for.",
            "in": "path",
            "name": "season",
            "required": true,
            "schema": {
              "description": "NFL season year to fetch. Must be one the league has data for.",
              "examples": [2026],
              "minimum": 2000,
              "title": "Season",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueScheduleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`X-Service-Token` header missing or incorrect."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ESPN could not be read: expired cookies (private leagues), unknown league ID, request failure/timeout, or a response shape this service doesn't recognize. `detail` says which."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List season schedule and scores",
        "tags": ["schedule"]
      }
    },
