            "description": "Away win probability, 0-1. Null except for the current week.",
            "title": "Away Win Probability"
          },
          "espn_matchup_id": {
            "description": "ESPN's numeric matchup ID. Joins to box scores.",
            "title": "Espn Matchup Id",
            "type": "integer"
          },
          "home_espn_team_id": {
            "title": "Home Espn Team Id",
            "type": "integer"
          },
          "home_projected_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
