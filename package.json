{
  "name": "cary-bengals",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build",
    "build:netlify": "cross-env INIT_CWD=$PWD next build",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts"
  },
  "dependencies": {
    "@next/bundle-analyzer": "13.5.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.13",
    "framer-motion": "^13.1.0",
    "gray-matter": "^4.0.2",
    "next": "13.5.3",
    "next-themes": "^0.2.1",
    "pliny": "0.1.4",
    "postcss": "^8.4.24",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^8",
    "swagger-ui-react": "5.17.14",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.14.3",
    "@svgr/webpack": "^8.0.1",
    "@types/mdx": "^2.0.5",
    "@types/react": "^18.2.14",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-config-next": "13.5.3",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "typescript": "^5.1.3"
  },
  "resolutions": {
    "@opentelemetry/api": "1.4.1",
    "@opentelemetry/core": "1.13.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.39.1",
    "@opentelemetry/resources": "1.13.0",
    "@opentelemetry/sdk-trace-base": "1.13.0",
    "@opentelemetry/sdk-trace-node": "1.13.0",
    "@opentelemetry/semantic-conventions": "1.13.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ],
    "backend/**/*.py": [
      "env UV_PROJECT_ENVIRONMENT=env uv run --project backend ruff check --fix",
      "env UV_PROJECT_ENVIRONMENT=env uv run --project backend black"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
