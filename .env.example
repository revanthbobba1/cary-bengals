# Supabase project (required) -- gates /admin auth and backs articles/teams/poll data.
# During local dev/build without a real project, leave NEXT_PUBLIC_SUPABASE_URL containing
# 'your-project-ref' (as below) to fall back to local fixture data instead of failing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...), replacing the legacy anon JWT. Supabase Dashboard >
# Project Settings > API Keys. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only needed for scripts/migrations that use the Supabase CLI/Management API.
SUPABASE_ACCESS_TOKEN=

# ESPN sync service (backend/) — server-only, no NEXT_PUBLIC_ prefix. Points at a local
# `uv run uvicorn` instance during dev; the Render URL once Phase 4 deploys the service.
ESPN_SERVICE_URL=
ESPN_SERVICE_TOKEN=

# ESPN scheduled sync (Phase 8c-cron) — server-only, no NEXT_PUBLIC_ prefix. Both only ever read
# by app/api/espn/sync-matchups/route.ts and app/api/espn/sync-all/route.ts and the Netlify
# scheduled functions that call them. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security on every table in the
# project — never log it, never pass it to client code. Copy it from the Supabase dashboard
# (Project Settings > API > service_role key). ESPN_SYNC_CRON_SECRET is a random shared secret
# (e.g. `openssl rand -hex 32`) checked before the service-role key is ever touched; the same
# value must be set in the Netlify env so the scheduled functions can authenticate.
SUPABASE_SERVICE_ROLE_KEY=
ESPN_SYNC_CRON_SECRET=

# Poll reminder emails (docs/POLL_REMINDERS_PLAN.md) — server-only, read by lib/email/sendEmail.ts.
# The league Gmail account, with 2-Step Verification on and an app password from
# myaccount.google.com/apppasswords (a normal password does not work over SMTP). While either is
# blank, reminders are logged to the console ("dry run") instead of sent. Never commit real values.
# app/api/polls/send-reminders/route.ts also uses SUPABASE_SERVICE_ROLE_KEY and
# ESPN_SYNC_CRON_SECRET from above.
GMAIL_USER=
GMAIL_APP_PASSWORD=
