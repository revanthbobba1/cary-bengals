# Supabase project (required) -- gates /admin auth and backs articles/teams/poll data.
# During local dev/build without a real project, leave NEXT_PUBLIC_SUPABASE_URL containing
# 'your-project-ref' (as below) to fall back to local fixture data instead of failing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed for scripts/migrations that use the Supabase CLI/Management API.
SUPABASE_ACCESS_TOKEN=

# visit https://giscus.app to get your Giscus ids
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
NEXT_PUBLIC_UTTERANCES_REPO=
NEXT_PUBLIC_DISQUS_SHORTNAME=


MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

BUTTONDOWN_API_KEY=

CONVERTKIT_API_KEY=
# curl https://api.convertkit.com/v3/forms?api_key=<your_public_api_key> to get your form ID
CONVERTKIT_FORM_ID=

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

REVUE_API_KEY=

EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# ESPN sync service (backend/) — server-only, no NEXT_PUBLIC_ prefix. Points at a local
# `uv run uvicorn` instance during dev; the Render URL once Phase 4 deploys the service.
ESPN_SERVICE_URL=
ESPN_SERVICE_TOKEN=

# ESPN scheduled sync (Phase 8c-cron) — server-only, no NEXT_PUBLIC_ prefix. Both only ever read
# by app/api/espn/sync-matchups/route.ts and app/api/espn/sync-all/route.ts, never by GitHub
# Actions directly. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security on every table in the
# project — never log it, never pass it to client code. Copy it from the Supabase dashboard
# (Project Settings > API > service_role key). ESPN_SYNC_CRON_SECRET is a random shared secret
# (e.g. `openssl rand -hex 32`) checked before the service-role key is ever touched; the same
# value must also be set as a GitHub Actions secret so the scheduled workflows can authenticate.
SUPABASE_SERVICE_ROLE_KEY=
ESPN_SYNC_CRON_SECRET=
